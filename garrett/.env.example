# Garrett Research Agent Configuration
# Copy this to .env and fill in your values

# === Anthropic API ===
ANTHROPIC_API_KEY=sk-ant-your-key-here

# === Notion API ===
# Get your integration token at https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your-notion-key-here

# Notion Database IDs (find in database URL: notion.so/{workspace}/{database_id}?v=...)
NOTION_RESEARCH_DB=your-research-findings-database-id
NOTION_PARTS_DB=your-parts-wishlist-database-id
NOTION_PROJECTS_DB=your-current-projects-database-id

# === Web Search ===
# SerpAPI: https://serpapi.com/ (free tier: 100 searches/month)
SERPAPI_KEY=your-serpapi-key-here

# === Email Configuration ===
# Option 1: SMTP (Gmail, etc.)
EMAIL_METHOD=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

# Option 2: SendGrid
# EMAIL_METHOD=sendgrid
# SENDGRID_API_KEY=your-sendgrid-key
# EMAIL_FROM=garrett@yourdomain.com
# EMAIL_TO=your-email@gmail.com

# === Agent Settings ===
# How many research queries to generate per run
MAX_QUERIES=3

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Car details (customize for your build)
CAR_YEAR=1968
CAR_MAKE=Chevrolet
CAR_MODEL=Chevelle SS 396
